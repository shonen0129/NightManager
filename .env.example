# Tachibana Securities API Credentials (Demo & Production)

# Selected provider (e.g. 'tachibana', 'kabu', or 'dry_run')
BROKER_PROVIDER=tachibana

# Tachibana API Configuration
# Base API URL: 
# Demo: https://demo-kabuka.e-shiten.jp/e_api_v4r10
# Production: https://kabuka.e-shiten.jp/e_api_v4r10
TACHIBANA_API_URL=https://demo-kabuka.e-shiten.jp/e_api_v4r10

# Set the Auth ID (sAuthId) generated from the e-Shiten API settings screen in your local .env file.
TACHIBANA_AUTH_ID=

# Absolute path to your decrypted e_api private key PEM file (e.g. /Users/username/keys/private_key.pem)
TACHIBANA_PRIVATE_KEY_PATH=/Users/your_username/keys/e_api_private_key.pem

# Set the second password (trading password) in your local .env file.
TACHIBANA_SECOND_PASSWORD=

# Optional Configurations
TACHIBANA_REQUEST_TIMEOUT=15
TACHIBANA_MARGIN_TRADE_TYPE=3
TACHIBANA_ACCOUNT_TYPE=4
