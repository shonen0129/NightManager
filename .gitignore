prof_*

# kabu_auto_login credentials
kabu_auto_login/creds/
kabu_auto_login/.env

# Scratch / temporary analysis scripts
scratch/

# Large generated artifacts (parquet, csv experiment outputs)
artifacts/

# Large generated results and plots
results/
shadow_runs/
live/
# Exceptions for markdown reports / diffs
!results/**/*.md
!results/**/*.patch
!shadow_runs/**/*.md
# Protect operational pipeline data from accidental cleanup
!live/pipeline_data/
!live/pipeline_data/**
live/pipeline_data/cache/

# Generated experiment outputs and artifacts
outputs/
data/adr_features.csv

# Consolidated runtime output directory (new convention)
var/

# Symlinks left by var/ migration for backward compatibility (ADR-0006).
# These must NOT be tracked; the canonical directories live under var/.
/artifacts
/live
/logs
/market_data
/results
/shadow_runs
